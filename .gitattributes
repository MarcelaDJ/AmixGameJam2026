# =========================================
# .gitattributes para proyectos Unity
# =========================================

# Por defecto: normalizar saltos de línea de archivos de texto a LF en el repo
* text=auto eol=lf

# -------- Archivos de texto de Unity/código --------
*.cs      text diff=csharp eol=lf
*.cginc   text eol=lf
*.shader  text eol=lf
*.compute text eol=lf
*.uxml    text eol=lf
*.uss     text eol=lf
*.json    text eol=lf
*.xml     text eol=lf
*.txt     text eol=lf
*.md      text eol=lf

# -------- Archivos YAML de Unity (texto, pero mejor no mergear a mano) --------
*.meta       text eol=lf
*.unity      text eol=lf merge=unityyamlmerge
*.prefab     text eol=lf merge=unityyamlmerge
*.asset      text eol=lf merge=unityyamlmerge
*.mat        text eol=lf merge=unityyamlmerge
*.physicMaterial   text eol=lf merge=unityyamlmerge
*.physicsMaterial2D text eol=lf merge=unityyamlmerge
*.anim       text eol=lf merge=unityyamlmerge
*.controller text eol=lf merge=unityyamlmerge
*.overrideController text eol=lf merge=unityyamlmerge
*.mask       text eol=lf merge=unityyamlmerge
*.brush      text eol=lf merge=unityyamlmerge
*.flare      text eol=lf merge=unityyamlmerge
*.fontsettings text eol=lf merge=unityyamlmerge
*.guiskin    text eol=lf merge=unityyamlmerge
*.giparams   text eol=lf merge=unityyamlmerge
*.renderTexture text eol=lf merge=unityyamlmerge
*.spriteatlas text eol=lf merge=unityyamlmerge
*.terrainlayer text eol=lf merge=unityyamlmerge
*.mixer      text eol=lf merge=unityyamlmerge
*.shadervariants text eol=lf merge=unityyamlmerge

# -------- Binarios: NUNCA tocar saltos de línea --------
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.psd   binary
*.tga   binary
*.tif   binary
*.tiff  binary
*.exr   binary
*.hdr   binary

*.wav   binary
*.mp3   binary
*.ogg   binary
*.aiff  binary

*.fbx   binary
*.obj   binary
*.blend binary
*.3ds   binary
*.max   binary

*.mp4   binary
*.mov   binary
*.webm  binary

*.dll   binary
*.pdb   binary
*.so    binary
*.dylib binary
*.a     binary
*.exe   binary

*.zip   binary
*.7z    binary
*.rar   binary

*.ttf   binary
*.otf   binary

*.unitypackage binary

# -------- Opcional: usar Git LFS para binarios pesados --------
# Si en algún momento el proyecto crece y querés usar Git LFS,
# descomentá y ajustá según lo que uses:
#
# *.psd filter=lfs diff=lfs merge=lfs -text
# *.fbx filter=lfs diff=lfs merge=lfs -text
# *.png filter=lfs diff=lfs merge=lfs -text
